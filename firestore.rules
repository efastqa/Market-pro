rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Listings collection
    match /listings/{listingId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Commercial Banners & Spotlight
    match /commercial_banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /hero_spotlight/{spotlightId} {
      allow read: if true;
      allow write: if true;
    }
    
    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Real-time conversations & messages
    match /conversations/{conversationId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Saved Alerts
    match /saved_alerts/{alertId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Transactions
    match /transactions/{transactionId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Platform config
    match /platform_config/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
